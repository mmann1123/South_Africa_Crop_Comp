\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces Patch generation per field. Each field is tiled into 100\nobreakspace  {}m patches---only ${\sim }10\times 10$ pixels at the 10\nobreakspace  {}m Sentinel-2 resolution---and resampled to $128\times 128$. These patches are the input to the patch-based 2D and 3D CNNs, whose per-patch predictions are later aggregated to a field label by majority vote.}}{8}{figure.5}\protected@file@percent }
\newlabel{sfig:patches}{{S5}{8}{Patch generation per field. Each field is tiled into 100~m patches---only ${\sim }10\times 10$ pixels at the 10~m Sentinel-2 resolution---and resampled to $128\times 128$. These patches are the input to the patch-based 2D and 3D CNNs, whose per-patch predictions are later aggregated to a field label by majority vote}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S6}{\ignorespaces Patch-level 3D CNN pipeline: each field is tiled into 100\nobreakspace  {}m patches resampled to $128\times 128$; a five-seed ensemble averages softmax outputs, and per-patch predictions are aggregated to a field label by majority vote.}}{9}{figure.6}\protected@file@percent }
\newlabel{sfig:patchmodel}{{S6}{9}{Patch-level 3D CNN pipeline: each field is tiled into 100~m patches resampled to $128\times 128$; a five-seed ensemble averages softmax outputs, and per-patch predictions are aggregated to a field label by majority vote}{figure.6}{}}
