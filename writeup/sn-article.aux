\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Per-class spatial-transfer F1 for four representative models. Lucerne/medics and canola are classified well by all; barley, wheat, and small-grain grazing concentrate the errors. CNN-BiLSTM degrades across every class.\relax }}{33}{figure.caption.40}\protected@file@percent }
\newlabel{fig:perclass}{{14}{33}{Per-class spatial-transfer F1 for four representative models. Lucerne/medics and canola are classified well by all; barley, wheat, and small-grain grazing concentrate the errors. CNN-BiLSTM degrades across every class.\relax }{figure.caption.40}{}}
\@writefile{toc}{\contentsline {paragraph}{Two robustness levers.}{33}{section*.43}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Generalization gap ($\Delta $ macro-F1, spatial-transfer minus in-region) grouped by inductive-bias family. Sparse/tree-like and linear models transfer (small $|\Delta |$); dense temporal/patch deep nets and synthetic augmentation overfit the training region. The sparse-attention L-TAE-S falls between the two regimes ($\Delta =-0.17$), showing that adding feature sparsity to a dense attention backbone partly recovers transfer. Bars show family means; points are individual models.\relax }}{34}{figure.caption.42}\protected@file@percent }
\newlabel{fig:bias}{{15}{34}{Generalization gap ($\Delta $ macro-F1, spatial-transfer minus in-region) grouped by inductive-bias family. Sparse/tree-like and linear models transfer (small $|\Delta |$); dense temporal/patch deep nets and synthetic augmentation overfit the training region. The sparse-attention L-TAE-S falls between the two regimes ($\Delta =-0.17$), showing that adding feature sparsity to a dense attention backbone partly recovers transfer. Bars show family means; points are individual models.\relax }{figure.caption.42}{}}
