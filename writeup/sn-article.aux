\@writefile{toc}{\contentsline {paragraph}{Why tree-like inductive bias transfers.}{34}{section*.41}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Generalization gap ($\Delta $ macro-F1, spatial-transfer minus in-region) grouped by inductive-bias family. Sparse/tree-like and linear models transfer (small $|\Delta |$); dense temporal/patch deep nets and synthetic augmentation overfit the training region. The sparse-attention L-TAE-S falls between the two regimes ($\Delta =-0.17$), showing that adding feature sparsity to a dense attention backbone partly recovers transfer. Bars show family means; points are individual models.\relax }}{35}{figure.caption.42}\protected@file@percent }
\newlabel{fig:bias}{{15}{35}{Generalization gap ($\Delta $ macro-F1, spatial-transfer minus in-region) grouped by inductive-bias family. Sparse/tree-like and linear models transfer (small $|\Delta |$); dense temporal/patch deep nets and synthetic augmentation overfit the training region. The sparse-attention L-TAE-S falls between the two regimes ($\Delta =-0.17$), showing that adding feature sparsity to a dense attention backbone partly recovers transfer. Bars show family means; points are individual models.\relax }{figure.caption.42}{}}
