\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Spatial-transfer (ST) macro-F1 (and gap $\Delta $) at pixel versus field level for architectures evaluated at both granularities. The pixel input is raw reflectance in every case; the \emph  {Field input} column gives the field-level representation — either the automated \texttt  {xr\_fresh} statistics or the field-averaged raw time series (raw-avg). For the tree learners (XGBoost, LightGBM) the pixel$\rightarrow $field change is therefore precisely a raw$\rightarrow $\texttt  {xr\_fresh} change. Field aggregation helps the dense temporal nets and is roughly neutral for the tree models, but degrades TabNet.\relax }}{30}{table.caption.39}\protected@file@percent }
\newlabel{tab:pixfield}{{5}{30}{Spatial-transfer (ST) macro-F1 (and gap $\Delta $) at pixel versus field level for architectures evaluated at both granularities. The pixel input is raw reflectance in every case; the \emph {Field input} column gives the field-level representation — either the automated \texttt {xr\_fresh} statistics or the field-averaged raw time series (raw-avg). For the tree learners (XGBoost, LightGBM) the pixel$\rightarrow $field change is therefore precisely a raw$\rightarrow $\texttt {xr\_fresh} change. Field aggregation helps the dense temporal nets and is roughly neutral for the tree models, but degrades TabNet.\relax }{table.caption.39}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Spatial-transfer macro-F1 at pixel versus field level. Field-level aggregation recovers transfer for dense temporal models (L-TAE) but collapses the sparsity-reliant TabNet.\relax }}{30}{figure.caption.40}\protected@file@percent }
\newlabel{fig:pixfield}{{13}{30}{Spatial-transfer macro-F1 at pixel versus field level. Field-level aggregation recovers transfer for dense temporal models (L-TAE) but collapses the sparsity-reliant TabNet.\relax }{figure.caption.40}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Spatial-transfer macro-F1 as the number of training fields is reduced to $75\%$, $50\%$, and $25\%$. Robust models (TabNet, logistic regression) are nearly flat; LassoNet is weak throughout.\relax }}{31}{figure.caption.41}\protected@file@percent }
\newlabel{fig:reduction}{{14}{31}{Spatial-transfer macro-F1 as the number of training fields is reduced to $75\%$, $50\%$, and $25\%$. Robust models (TabNet, logistic regression) are nearly flat; LassoNet is weak throughout.\relax }{figure.caption.41}{}}
