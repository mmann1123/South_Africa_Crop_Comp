\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Per-class F1 on the holdout region for four representative models (TabNet, L-TAE-S, L-TAE, and CNN-BiLSTM). TabNet and L-TAE-S classify lucerne/medics and canola best; the cereals (barley, wheat) and small-grain grazing concentrate the errors. The dense L-TAE and CNN-BiLSTM also trail on the easier classes. Error bars are 95\% bootstrap CIs over holdout fields.}}{14}{figure.3}\protected@file@percent }
\newlabel{fig:perclass}{{3}{14}{Per-class F1 on the holdout region for four representative models (TabNet, L-TAE-S, L-TAE, and CNN-BiLSTM). TabNet and L-TAE-S classify lucerne/medics and canola best; the cereals (barley, wheat) and small-grain grazing concentrate the errors. The dense L-TAE and CNN-BiLSTM also trail on the easier classes. Error bars are 95\% bootstrap CIs over holdout fields}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}Raw Reflectance versus \texttt  {xr\_fresh}}{14}{subsection.4.5}\protected@file@percent }
\newlabel{sec:repr}{{4.5}{14}{Raw Reflectance versus \texttt {xr\_fresh}}{subsection.4.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Data efficiency under out-of-region transfer: macro-F1 versus fraction of training fields retained, single training seed, each point the mean over five independent subsample draws (error bars $\pm 1$ s.d.). The deep temporal models (L-TAE, L-TAE-S) are nearly flat to a quarter of the fields; the tree, linear, and TabNet baselines decline modestly. Per-fraction variation is within draw-to-draw sampling noise, largest for L-TAE-S ($\pm 0.06$ at $50\%$), so single-split ``dips'' are not real. Absolute values run ${\sim }0.02$--$0.05$ below the five-seed levels of Table\nobreakspace  {}\ref  {tab:gap} because a single training seed is used.}}{15}{figure.4}\protected@file@percent }
\newlabel{fig:reduction}{{4}{15}{Data efficiency under out-of-region transfer: macro-F1 versus fraction of training fields retained, single training seed, each point the mean over five independent subsample draws (error bars $\pm 1$ s.d.). The deep temporal models (L-TAE, L-TAE-S) are nearly flat to a quarter of the fields; the tree, linear, and TabNet baselines decline modestly. Per-fraction variation is within draw-to-draw sampling noise, largest for L-TAE-S ($\pm 0.06$ at $50\%$), so single-split ``dips'' are not real. Absolute values run ${\sim }0.02$--$0.05$ below the five-seed levels of Table~\ref {tab:gap} because a single training seed is used}{figure.4}{}}
